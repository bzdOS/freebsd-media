# E6: sweep the low nibble of the trigger register with the synthetic start-code buffer
reset
fill 0 0x800000 0
fill 0 0x1000 0xff
fill 100 2 0x00
fill 102 1 0x01
fill 103 1 0xb8
wr 0x000 0xc0000000
wrvld 0x128 0 5
wr 0x130 0x8000
wrpa 0x134 0xfff
wr 0x11c 0x0800000f
wr 0x12c 0
echo trig 0x00000000|1
wr 0x118 0x1
sleep 5
rd 0x11c
rd 0x1f0
rd 0x1c4
wr 0x11c 0x0800000f
wr 0x12c 0
echo trig 0x00000000|2
wr 0x118 0x2
sleep 5
rd 0x11c
rd 0x1f0
rd 0x1c4
wr 0x11c 0x0800000f
wr 0x12c 0
