# E5: start-code search on a synthetic buffer: 0xff everywhere, a start code 00 00 01 b8 at byte 100 (bit 800)
reset
fill 0 0x800000 0
fill 0 0x1000 0xff
fill 100 2 0x00
fill 102 1 0x01
fill 103 1 0xb8
wr 0x000 0xc0000000
wrvld 0x128 0 5
wr 0x130 0x8000
wrpa 0x134 0xfff
wr 0x12c 0
wr 0x11c 0x0800000f
rd 0x11c
wr 0x118 0x02000008
poll 0x11c 0x08000000 0x08000000 100
rd 0x11c
rd 0x1f0
echo --- again, clear bit27 first, offset 100 bits
wr 0x11c 0x0800000f
wr 0x12c 100
wr 0x118 0x02000008
sleep 20
rd 0x11c
rd 0x1f0
echo --- offset 801 bits (past the code)
wr 0x11c 0x0800000f
wr 0x12c 801
wr 0x118 0x02000008
sleep 20
rd 0x11c
rd 0x1f0
echo --- search with the tag 0x0e instead (decode trigger) on the same buffer
wr 0x11c 0x0800000f
wr 0x12c 0
wr 0x118 0x0200000e
sleep 20
rd 0x11c
rd 0x1f0
