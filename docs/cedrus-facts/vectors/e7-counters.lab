# E7: does anything count? cycle counter 0x008 after engine select / sub-engine reset pulse
reset
wr 0x000 0xc0000000
rd 0x008
sleep 10
rd 0x008
echo --- sub-engine reset pulse via 0x004
wr 0x004 0x1
rd 0x004
wr 0x004 0x0
rd 0x004
rd 0x000
wr 0x000 0xc0000000
sleep 10
rd 0x008
echo --- write the counter
wr 0x008 0xffffffff
rd 0x008
echo --- timeout reg
wr 0x00c 0xffffffff
rd 0x00c
echo --- every engine select value
wr 0x000 0xc0000001
rd 0x000
sleep 10
rd 0x008
wr 0x000 0xc0000000
