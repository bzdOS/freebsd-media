# E8: does any ordering of the VLD register writes make the search read DRAM (counter 0x020)?
reset
fill 0 0x800000 0
fill 0 0x1000 0xff
fill 100 2 0x00
fill 102 1 0x01
fill 103 1 0xb8
wr 0x000 0xc0000000
wr 0x008 0x80000000
wr 0x020 0x80000000
wr 0x024 0x80000000
echo order AOL
wrvld 0x128 0 5
wr 0x12c 0
wr 0x130 0x8000
wrpa 0x134 0xfff
wr 0x11c 0x0800000f
wr 0x118 0x02000008
sleep 5
rd 0x11c
rd 0x1f0
rd 0x020
echo order ALO
wrvld 0x128 0 5
wr 0x130 0x8000
wr 0x12c 0
wrpa 0x134 0xfff
wr 0x11c 0x0800000f
wr 0x118 0x02000008
sleep 5
rd 0x11c
rd 0x1f0
rd 0x020
echo order OAL
wr 0x12c 0
wrvld 0x128 0 5
wr 0x130 0x8000
wrpa 0x134 0xfff
wr 0x11c 0x0800000f
wr 0x118 0x02000008
sleep 5
rd 0x11c
rd 0x1f0
rd 0x020
echo order OLA
wr 0x12c 0
wr 0x130 0x8000
wrvld 0x128 0 5
wrpa 0x134 0xfff
wr 0x11c 0x0800000f
wr 0x118 0x02000008
sleep 5
rd 0x11c
rd 0x1f0
rd 0x020
echo order LAO
wr 0x130 0x8000
wrvld 0x128 0 5
wr 0x12c 0
wrpa 0x134 0xfff
wr 0x11c 0x0800000f
wr 0x118 0x02000008
sleep 5
rd 0x11c
rd 0x1f0
rd 0x020
echo order LOA
wr 0x130 0x8000
wr 0x12c 0
wrvld 0x128 0 5
wrpa 0x134 0xfff
wr 0x11c 0x0800000f
wr 0x118 0x02000008
sleep 5
rd 0x11c
rd 0x1f0
rd 0x020
