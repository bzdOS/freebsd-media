# E4: the engine's start-code search (trigger low nibble 0x8): does the VLD read our stream,
# and what does it report in 0x1f0 for various starting offsets? Start codes are at
# bytes 0 (b3), 30 (00 picture), 47 (slice 01 ...)
reset
fill 0 0x800000 0
load i64.m2v 0
wr 0x000 0xc0000000
wrvld 0x128 0 5
wr 0x130 17600
wrpa 0x134 0x7fffff
echo --- offset 0
wr 0x12c 0
rd 0x12c
wr 0x11c 0x7
wr 0x118 0x02000008
poll 0x11c 0x7 0x1 100
rd 0x1f0
rd 0x12c
echo --- offset 8 bits
wr 0x11c 0x7
wr 0x12c 8
wr 0x118 0x02000008
poll 0x11c 0x7 0x1 100
rd 0x1f0
echo --- offset 64 bits
wr 0x11c 0x7
wr 0x12c 64
wr 0x118 0x02000008
poll 0x11c 0x7 0x1 100
rd 0x1f0
echo --- offset 250 bits
wr 0x11c 0x7
wr 0x12c 250
wr 0x118 0x02000008
poll 0x11c 0x7 0x1 100
rd 0x1f0
